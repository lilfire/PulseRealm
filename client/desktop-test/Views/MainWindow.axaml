<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PulseRealm.DesktopTest.ViewModels"
        xmlns:svc="using:PulseRealm.DesktopTest.Services"
        x:Class="PulseRealm.DesktopTest.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PulseRealm — Tracking"
        Icon="avares://PulseRealm.DesktopTest/Assets/logo.png"
        Width="800" Height="500"
        MinWidth="400" MinHeight="300"
        Background="#0f172a">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#e2e8f0" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0f172a" />
      <Setter Property="Foreground" Value="#e2e8f0" />
      <Setter Property="BorderBrush" Value="#475569" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#38bdf8" />
      <Setter Property="Foreground" Value="#0f172a" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>

  <Panel>
    <!-- Tracking area -->
    <Border Background="#0f172a" Cursor="Cross" x:Name="TrackingArea">
      <Panel>
        <!-- Hint text -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Foreground="#475569" IsHitTestVisible="False">
          <Run Text="Click &amp; Move" FontSize="28" FontWeight="Bold" Foreground="#64748b" />
          <LineBreak />
          <LineBreak />
          <Run Text="Mouse clicks → steps (each click = 1 step)" />
          <LineBreak />
          <Run Text="Mouse movement → heart rate (speed maps to bpm)" />
          <LineBreak />
          <Run Text="Use the Controls window to join a realm." />
        </TextBlock>

        <!-- Incline display — bottom-right corner -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20" IsHitTestVisible="False" Spacing="2">
          <TextBlock Text="INCLINE" FontSize="11" FontWeight="SemiBold" Foreground="#94a3b8"
                     HorizontalAlignment="Right" LetterSpacing="2" />
          <TextBlock Text="{Binding Incline, StringFormat='{}{0:F1}%'}"
                     FontSize="32" FontWeight="Bold" Foreground="#fbbf24"
                     HorizontalAlignment="Right" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- Search overlay -->
    <Border Background="#0f172a" IsVisible="{Binding IsSearching}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="100">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Image Source="avares://PulseRealm.DesktopTest/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center" />
        <TextBlock Text="PulseRealm" FontSize="28" Foreground="#38bdf8" FontWeight="Bold" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Border Width="10" Height="10" CornerRadius="5" Background="#38bdf8" Classes="dot1">
            <Border.Styles>
              <Style Selector="Border.dot1">
                <Style.Animations>
                  <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="33%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                    <KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Border.Styles>
          </Border>
          <Border Width="10" Height="10" CornerRadius="5" Background="#38bdf8" Classes="dot2">
            <Border.Styles>
              <Style Selector="Border.dot2">
                <Style.Animations>
                  <Animation Duration="0:0:1.2" Delay="0:0:0.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="33%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                    <KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Border.Styles>
          </Border>
          <Border Width="10" Height="10" CornerRadius="5" Background="#38bdf8" Classes="dot3">
            <Border.Styles>
              <Style Selector="Border.dot3">
                <Style.Animations>
                  <Animation Duration="0:0:1.2" Delay="0:0:0.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="33%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                    <KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Border.Styles>
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding SearchStatus}" FontSize="15" Foreground="#94a3b8" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Realm ended overlay -->
    <Border Background="#e6000000" IsVisible="{Binding RealmIsEnded}" ZIndex="200"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="420">
        <Image Source="avares://PulseRealm.DesktopTest/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock Text="Realm Complete" FontSize="24" Foreground="#38bdf8" FontWeight="Bold" HorizontalAlignment="Center" />
        <Border Background="#1e293b" CornerRadius="10" Padding="20" BorderBrush="#334155" BorderThickness="1">
          <TextBlock Text="{Binding SummaryText}" FontSize="14" Foreground="#e2e8f0" TextWrapping="Wrap"
                     TextAlignment="Center" LineHeight="24" />
        </Border>
        <Button Content="OK" Command="{Binding DismissSummaryCommand}" HorizontalAlignment="Center"
                Padding="20,6" FontSize="14" />
      </StackPanel>
    </Border>

    <!-- Bind request overlay -->
    <Border Background="#e6000000" IsVisible="{Binding ShowBindRequest}" ZIndex="250"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="360">
        <TextBlock Text="BIND REQUEST" FontSize="16" Foreground="#38bdf8" FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding BindCode}" FontSize="56" FontWeight="Bold" FontFamily="Consolas, monospace"
                   Foreground="#e2e8f0" HorizontalAlignment="Center" />
        <TextBlock Text="A dashboard wants to bind to you.&#x0a;Confirm the code matches, then approve or decline."
                   FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
          <Button Content="Approve" Command="{Binding ApproveBindCommand}"
                  Background="#22c55e" Foreground="White" Padding="20,6" FontSize="14" />
          <Button Content="Decline" Command="{Binding DeclineBindCommand}"
                  Background="#ef4444" Foreground="White" Padding="20,6" FontSize="14" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Not found / manual entry overlay (local mode) -->
    <Border Background="#0f172a" IsVisible="{Binding ShowManualEntry}" ZIndex="100"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="350">
        <Image Source="avares://PulseRealm.DesktopTest/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center" />
        <TextBlock Text="PulseRealm" FontSize="28" Foreground="#38bdf8" FontWeight="Bold" HorizontalAlignment="Center" />
        <Border Width="48" Height="48" CornerRadius="24" Background="#28f87171" HorizontalAlignment="Center">
          <TextBlock Text="&#x2715;" FontSize="24" FontWeight="Bold" Foreground="#f87171"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="No server found on the network" FontSize="15" Foreground="#94a3b8" HorizontalAlignment="Center" />
        <TextBlock Text="Make sure the PulseRealm server is running and reachable." FontSize="12" Foreground="#64748b"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
          <Button Content="Retry Search" Command="{Binding RetrySearchCommand}" />
          <Button Content="Use Remote Server" Command="{Binding SwitchToRemoteCommand}"
                  Background="Transparent" BorderBrush="#475569" BorderThickness="1" Foreground="#94a3b8" />
        </StackPanel>

        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="Or enter a local address" FontSize="15" Foreground="#94a3b8" HorizontalAlignment="Center" />
          <TextBox Text="{Binding ManualUrl}" FontFamily="Consolas, monospace" />
          <Button Content="Connect" Command="{Binding ManualConnectCommand}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ManualError}" Foreground="#f87171" FontSize="13"
                     HorizontalAlignment="Center" IsVisible="{Binding ManualError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="Use the local IP of the machine running the server&#x0a;(e.g. http://10.0.5.2:5062)" FontSize="12"
                     Foreground="#64748b" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Server selection overlay (multiple servers found) -->
    <Border Background="#0f172a" IsVisible="{Binding ShowServerSelection}" ZIndex="100"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel x:Name="ServerSelectionPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="400">
        <Image Source="avares://PulseRealm.DesktopTest/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center" />
        <TextBlock Text="PulseRealm" FontSize="28" Foreground="#38bdf8" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Select a server" FontSize="16" Foreground="#94a3b8" HorizontalAlignment="Center" />

        <ItemsControl ItemsSource="{Binding DiscoveredServers}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:DiscoveredServer">
              <Button Command="{Binding #ServerSelectionPanel.DataContext.SelectServerCommand}"
                      CommandParameter="{Binding}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Background="#1e293b" Foreground="#e2e8f0" Margin="0,4" Padding="14,10" CornerRadius="8"
                      BorderBrush="#334155" BorderThickness="1">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="12" Foreground="#64748b" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#38bdf8" />
                    <TextBlock FontSize="12" Foreground="#94a3b8" FontFamily="Consolas, monospace">
                      <Run Text="{Binding Address}" /><Run Text=" · " /><Run Text="{Binding Hostname}" />
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="Or enter an address manually" FontSize="13" Foreground="#64748b" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <TextBox Text="{Binding ManualUrl}" FontFamily="Consolas, monospace" Width="260" Watermark="http://10.0.5.2:5062" />
            <Button Content="Connect" Command="{Binding ManualConnectCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ManualError}" Foreground="#f87171" FontSize="13"
                     HorizontalAlignment="Center" IsVisible="{Binding ManualError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,4,0,0">
          <Button Content="Retry Search" Command="{Binding RetrySearchCommand}"
                  Background="Transparent" BorderBrush="#475569" BorderThickness="1" Foreground="#94a3b8" />
          <Button Content="Use Remote Server" Command="{Binding SwitchToRemoteCommand}"
                  Background="Transparent" BorderBrush="#475569" BorderThickness="1" Foreground="#94a3b8" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Remote server overlay -->
    <Border Background="#0f172a" IsVisible="{Binding IsRemoteMode}" ZIndex="100"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="350">
        <Image Source="avares://PulseRealm.DesktopTest/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center" />
        <TextBlock Text="PulseRealm" FontSize="28" Foreground="#38bdf8" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Remote Server" FontSize="16" Foreground="#94a3b8" HorizontalAlignment="Center" />

        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="Enter the address of a hosted PulseRealm server" FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBox Text="{Binding RemoteUrl}" FontFamily="Consolas, monospace" />
          <Button Content="Connect" Command="{Binding RemoteConnectCommand}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ManualError}" Foreground="#f87171" FontSize="13"
                     HorizontalAlignment="Center" IsVisible="{Binding ManualError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="e.g. https://pulserealm.example.com" FontSize="12"
                     Foreground="#64748b" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>

        <Button Content="&#x2190; Back to Local Network" Command="{Binding SwitchToLocalCommand}" HorizontalAlignment="Center"
                Background="Transparent" BorderBrush="#475569" BorderThickness="1" Foreground="#94a3b8" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
